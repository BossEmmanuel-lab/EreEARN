# Django
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Stellar Network
STELLAR_NETWORK=TESTNET
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
STELLAR_ESCROW_SECRET=your-escrow-account-secret-key
STELLAR_ESCROW_PUBLIC=your-escrow-account-public-key
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Soroban Contracts
# SOROBAN_CONTRACT_ID = the C... address output by `stellar contract deploy`
SOROBAN_CONTRACT_ID=your-deployed-escrow-contract-id

# XLM Stellar Asset Contract (SAC) address
# This wraps native XLM for Soroban token transfers.
# It is NOT the same as SOROBAN_CONTRACT_ID (the escrow contract).
# Testnet: CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC
# Mainnet: run: python -c "from stellar_sdk import Asset; print(Asset.native().contract_id('Public Global Stellar Network ; September 2015'))"
SOROBAN_XLM_CONTRACT_ID=CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC

# USDC SAC (optional — derived automatically from USDC_ASSET_ISSUER if not set)
# SOROBAN_USDC_CONTRACT_ID=your-usdc-sac-contract-address
USDC_ASSET_CODE=USDC
USDC_ASSET_ISSUER=your-test-usdc-issuer-public-key

# Celery (optional, for background tasks)
CELERY_BROKER_URL=redis://localhost:6379/0
